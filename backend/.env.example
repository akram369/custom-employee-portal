PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_portal_key_2025_brainwave_assignment
JWT_EXPIRES_IN=8h

# Zoho One API Integration Settings
# Replace with your actual Zoho API Console credentials when ready
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token_here

# Zoho Regional Accounts URL (e.g., https://accounts.zoho.com or https://accounts.zoho.in)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# Database config
DB_PATH=./src/config/portal.sqlite
