{
  "name": "custom-employee-portal",
  "version": "1.0.0",
  "description": "Custom Employee Portal with Zoho One Integration and RBAC",
  "scripts": {
    "start": "node backend/server.js",
    "backend": "cd backend && node server.js",
    "frontend": "cd frontend && npm run dev",
    "test": "cd backend && node test-backend.js",
    "build": "cd frontend && npm run build",
    "db:reset": "cd backend && npm run db:reset",
    "install:all": "npm --prefix backend install && npm --prefix frontend install"
  },
  "keywords": [
    "zoho",
    "rbac",
    "employee-portal",
    "react",
    "express",
    "sqlite",
    "oauth2"
  ],
  "author": "Wasim Akram",
  "license": "MIT"
}
